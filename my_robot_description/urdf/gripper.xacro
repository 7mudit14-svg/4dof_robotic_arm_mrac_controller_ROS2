<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="gripper_base_link">
    <visual>
      <geometry><box size="0.2 0.06 0.02"/></geometry>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry><box size="0.2 0.06 0.02"/></geometry>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.2"/>
      <!-- box 0.2 x 0.06 x 0.02 -->
      <inertia ixx="0.000063" ixy="0" ixz="0"
               iyy="0.000673" iyz="0" izz="0.000703"/>
    </inertial>
  </link>

  <link name="left_finger_link">
    <visual>
      <geometry><box size="0.02 0.06 0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.06 0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.05"/>
      <!-- box 0.02 x 0.06 x 0.08 -->
      <inertia ixx="0.0000417" ixy="0" ixz="0"
               iyy="0.0000350" iyz="0" izz="0.0000100"/>
    </inertial>
  </link>

  <link name="right_finger_link">
    <visual>
      <geometry><box size="0.02 0.06 0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.06 0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000417" ixy="0" ixz="0"
               iyy="0.0000350" iyz="0" izz="0.0000100"/>
    </inertial>
  </link>

  <joint name="gripper_left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="-0.07 0 0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" velocity="1.0" lower="0.0" upper="0.06"/>
  </joint>

  <joint name="gripper_right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.07 0 0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- Note: Mimic constraint removed for Gazebo compatibility -->
    <!-- Gazebo ODE physics engine doesn't support mimic joints -->
    <!-- Fingers can be controlled independently or synchronized via controller -->
    <limit effort="100" velocity="1.0" lower="-0.06" upper="0.0"/>
  </joint>

</robot>
