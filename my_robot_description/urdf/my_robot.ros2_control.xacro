<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="my_robot_ros2_control" params="name initial_positions_file use_sim:=true">

  <xacro:property name="initial_positions"
    value="${xacro.load_yaml(initial_positions_file)}"/>

  <ros2_control name="${name}" type="system">
    <hardware>
      <xacro:if value="${use_sim}">
        <!-- GazeboSimSystem = Gazebo Harmonic / Jazzy correct plugin name -->
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="${use_sim}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:unless>
    </hardware>

    <!-- ARM joints: effort command interface so MRAC torques are accepted -->
    <joint name="joint1">
      <command_interface name="effort">
        <param name="min">-150</param>
        <param name="max"> 150</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['initial_positions']['joint1']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint2">
      <command_interface name="effort">
        <param name="min">-150</param>
        <param name="max"> 150</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['initial_positions']['joint2']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint3">
      <command_interface name="effort">
        <param name="min">-100</param>
        <param name="max"> 100</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['initial_positions']['joint3']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint4">
      <command_interface name="effort">
        <param name="min">-50</param>
        <param name="max"> 50</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['initial_positions']['joint4']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Gripper: position control only -->
    <joint name="gripper_left_finger_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.06</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['initial_positions']['gripper_left_finger_joint']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- Gazebo plugin that creates /controller_manager — MUST be here -->
  <xacro:if value="${use_sim}">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find my_robot_bringup)/config/ros2_controllers.yaml</parameters>
        <ros>
          <remapping>/controller_manager/robot_description:=/robot_description</remapping>
        </ros>
      </plugin>
    </gazebo>
  </xacro:if>

</xacro:macro>
</robot>
