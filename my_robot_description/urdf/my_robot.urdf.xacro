<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <xacro:arg name="initial_positions_file" 
    default="$(find my_robot_description)/urdf/initial_positions.yaml"/>
  <xacro:arg name="payload_mass" default="0.0"/>
  <xacro:arg name="use_sim"      default="true"/>

  <!-- Include all components -->
  <xacro:include filename="$(find my_robot_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/arm.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/gripper.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/my_robot.ros2_control.xacro"/>

  <!-- Gripper joint -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool_link"/>
    <child  link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Instantiate the ros2_control macro -->
  <xacro:my_robot_ros2_control
    name="my_robot"
    initial_positions_file="$(arg initial_positions_file)"
    use_sim="$(arg use_sim)"/>

</robot>
