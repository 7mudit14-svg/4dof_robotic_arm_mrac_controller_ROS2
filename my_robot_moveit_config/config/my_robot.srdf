<?xml version="1.0" encoding="UTF-8"?>
<robot name="my_robot">

  <!-- ── Planning Groups ──────────────────────────────────────────────────── -->
  <group name="arm">
    <joint name="virtual_joint"/>
    <joint name="joint1"/>
    <joint name="joint2"/>
    <joint name="joint3"/>
    <joint name="joint4"/>
    <joint name="hand_tool_joint"/>
  </group>

  <group name="gripper">
    <joint name="gripper_base_joint"/>
    <joint name="gripper_left_finger_joint"/>
  </group>

  <!-- ── Named States ─────────────────────────────────────────────────────── -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
  </group_state>

  <group_state name="pose_1" group="arm">
    <joint name="joint1" value="-0.5031"/>
    <joint name="joint2" value="0.3591"/>
    <joint name="joint3" value="1.7818"/>
    <joint name="joint4" value="0.2256"/>
  </group_state>

  <group_state name="pose_2" group="arm">
    <joint name="joint1" value="1.3358"/>
    <joint name="joint2" value="0.7459"/>
    <joint name="joint3" value="2.1133"/>
    <joint name="joint4" value="1.267"/>
  </group_state>

  <group_state name="gripper_open"        group="gripper">
    <joint name="gripper_left_finger_joint" value="0"/>
  </group_state>
  <group_state name="gripper_closed"      group="gripper">
    <joint name="gripper_left_finger_joint" value="0.06"/>
  </group_state>
  <group_state name="gripper_half_closed" group="gripper">
    <joint name="gripper_left_finger_joint" value="0.03"/>
  </group_state>

  <!-- ── End Effector ─────────────────────────────────────────────────────── -->
  <end_effector name="gripper" parent_link="tool_link"
                group="gripper" parent_group="arm"/>

  <!-- ── Virtual Joint ────────────────────────────────────────────────────── -->
  <virtual_joint name="virtual_joint" type="fixed"
                 parent_frame="world" child_link="base_link"/>

  <!-- ── Disable Collisions: adjacent links ───────────────────────────────── -->
  <disable_collisions link1="base_link"         link2="shoulder_link"       reason="Adjacent"/>
  <disable_collisions link1="shoulder_link"     link2="arm_link"            reason="Adjacent"/>
  <disable_collisions link1="arm_link"          link2="elbow_link"          reason="Adjacent"/>
  <disable_collisions link1="elbow_link"        link2="hand_link"           reason="Adjacent"/>
  <disable_collisions link1="hand_link"         link2="gripper_base_link"   reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="left_finger_link"    reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="right_finger_link"   reason="Adjacent"/>

  <!-- ── Disable Collisions: non-adjacent arm pairs ───────────────────────── -->
  <disable_collisions link1="arm_link"          link2="gripper_base_link"   reason="Never"/>
  <disable_collisions link1="arm_link"          link2="hand_link"           reason="Never"/>
  <disable_collisions link1="arm_link"          link2="left_finger_link"    reason="Never"/>
  <disable_collisions link1="arm_link"          link2="right_finger_link"   reason="Never"/>
  <disable_collisions link1="arm_link"          link2="shoulder_link"       reason="Never"/>
  <disable_collisions link1="elbow_link"        link2="gripper_base_link"   reason="Never"/>
  <disable_collisions link1="elbow_link"        link2="left_finger_link"    reason="Never"/>
  <disable_collisions link1="elbow_link"        link2="right_finger_link"   reason="Never"/>
  <disable_collisions link1="elbow_link"        link2="shoulder_link"       reason="Never"/>
  <disable_collisions link1="hand_link"         link2="left_finger_link"    reason="Never"/>
  <disable_collisions link1="hand_link"         link2="right_finger_link"   reason="Never"/>
  <disable_collisions link1="hand_link"         link2="shoulder_link"       reason="Never"/>
  <disable_collisions link1="left_finger_link"  link2="right_finger_link"   reason="Never"/>
  <disable_collisions link1="left_finger_link"  link2="shoulder_link"       reason="Never"/>
  <disable_collisions link1="right_finger_link" link2="shoulder_link"       reason="Never"/>

  <!-- ── CRITICAL: payload_link collision pairs ───────────────────────────── -->
  <!-- payload_link is a fixed child of tool_link sitting inside the gripper.  -->
  <!-- Without ALL of these, MoveIt reports START_STATE_IN_COLLISION on every  -->
  <!-- planning request and aborts before calling the planner.                 -->
  <disable_collisions link1="payload_link" link2="gripper_base_link"  reason="Adjacent"/>
  <disable_collisions link1="payload_link" link2="left_finger_link"   reason="Never"/>
  <disable_collisions link1="payload_link" link2="right_finger_link"  reason="Never"/>
  <disable_collisions link1="payload_link" link2="hand_link"          reason="Never"/>
  <disable_collisions link1="payload_link" link2="tool_link"          reason="Adjacent"/>
  <disable_collisions link1="payload_link" link2="elbow_link"         reason="Never"/>
  <disable_collisions link1="payload_link" link2="arm_link"           reason="Never"/>
  <disable_collisions link1="payload_link" link2="shoulder_link"      reason="Never"/>
  <disable_collisions link1="payload_link" link2="base_link"          reason="Never"/>

</robot>
